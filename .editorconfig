root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown rather than a mistake,
# and list continuations indent to the width of their marker.
indent_size = unset
trim_trailing_whitespace = false

[*.rb]
# `brew style` owns this.
indent_size = unset

[.github/workflows/*.yml]
# A `run: |` block is shell pasted into YAML: heredocs, continued commands and
# case arms indent to what the shell reads. actionlint lints those blocks as
# shell, which is the check with something to say about them.
indent_size = unset
