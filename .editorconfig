root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Trailing spaces are hard breaks. List wrap follows the marker.
indent_size = unset
trim_trailing_whitespace = false

[*.rb]
# `brew style` owns this.
indent_size = unset

[.github/workflows/*.yml]
# run: | is shell. actionlint owns its indent.
indent_size = unset
