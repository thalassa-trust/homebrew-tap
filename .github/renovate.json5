{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
  ],

  enabledManagers: ["custom.regex", "github-actions"],

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^Casks/cua-driver\\.rb$/"],
      matchStrings: [
        'cask "cua-driver" do\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: 'cask "cua-driver" do\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.cua-driver",
      depNameTemplate: "Cua Driver",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Casks/kraken-desktop\\.rb$/"],
      matchStrings: [
        'cask "kraken-desktop" do\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: 'cask "kraken-desktop" do\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.kraken-desktop",
      depNameTemplate: "Kraken Desktop",
      versioningTemplate: "loose",
    },
  ],

  customDatasources: {
    "cua-driver": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/trycua/cua/releases?per_page=100",
      transformTemplates: [
        '{ "releases": $map($[$match(tag_name, /^cua-driver-rs-v[0-9]+\\.[0-9]+\\.[0-9]+$/)], function($release) { ($version := $substringAfter($release.tag_name, "cua-driver-rs-v"); { "version": $version, "releaseTimestamp": $release.published_at, "digest": $substringAfter($release.assets[name = "cua-driver-rs-" & $version & "-darwin-universal.tar.gz"].digest, "sha256:") }) }) }',
      ],
    },
    "kraken-desktop": {
      defaultRegistryUrlTemplate: "https://desktop-downloads.kraken.com/latest.json",
      transformTemplates: [
        '{ "releases": [{ "version": version & "," & revision, "digest": files.macos.sha256 }] }',
      ],
    },
  },

  timezone: "Etc/UTC",
  schedule: ["before 6am"],
  labels: ["dependencies"],
  commitMessageLowerCase: "never",

  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",

  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  automerge: false,

  // Load-bearing. The signature ruleset rejects unsigned git-CLI commits.
  // platformCommit makes GitHub sign what Renovate creates.
  platformCommit: "enabled",

  osvVulnerabilityAlerts: true,

  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    schedule: [],
    automerge: false,
    labels: ["dependencies", "security"],
  },

  packageRules: [
    {
      description: ["Kraken's feed omits release timestamps."],
      matchManagers: ["custom.regex"],
      matchPackageNames: ["Kraken Desktop"],
      minimumReleaseAge: null,
    },
    {
      description: [
        "Action digest refreshes. The tag is unchanged and only the resolved digest moves, so this re-pins the same declared release. pinact checks the result in `gate:ci`.",
      ],
      matchManagers: ["github-actions"],
      addLabels: ["security"],
    },
  ],

  // SHA256-fetched workflow tools remain manual pairs.
}
