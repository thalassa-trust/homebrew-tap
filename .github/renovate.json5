{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
  ],

  // No dashboard issue. Updates arrive as PRs with their own context.
  dependencyDashboard: false,

  enabledManagers: ["custom.regex", "github-actions"],

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^Casks/cua-driver\\.rb$/"],
      matchStrings: [
        'cask "cua-driver" do\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: 'cask "cua-driver" do\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.cua-driver",
      depNameTemplate: "Cua Driver",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Casks/kraken-desktop\\.rb$/"],
      matchStrings: [
        'cask "kraken-desktop" do\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: 'cask "kraken-desktop" do\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.kraken-desktop",
      depNameTemplate: "Kraken Desktop",
      versioningTemplate: "loose",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Formula/mewt\\.rb$/"],
      matchStrings: [
        '  url "https://github\\.com/trailofbits/mewt/releases/download/v[^"]+/mewt-aarch64-apple-darwin\\.tar\\.xz"\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: '  url "https://github.com/trailofbits/mewt/releases/download/v{{{newValue}}}/mewt-aarch64-apple-darwin.tar.xz"\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.mewt",
      depNameTemplate: "Mewt",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Formula/muton\\.rb$/"],
      matchStrings: [
        '  url "https://github\\.com/trailofbits/muton/releases/download/v[^"]+/muton-aarch64-apple-darwin\\.tar\\.xz"\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: '  url "https://github.com/trailofbits/muton/releases/download/v{{{newValue}}}/muton-aarch64-apple-darwin.tar.xz"\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.muton",
      depNameTemplate: "Muton",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Formula/beankeeper\\.rb$/"],
      matchStrings: [
        '  url "https://github\\.com/Govcraft/beankeeper/releases/download/beankeeper-cli-v[^"]+/bk-[^"]+-aarch64-apple-darwin\\.tar\\.gz"\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: '  url "https://github.com/Govcraft/beankeeper/releases/download/beankeeper-cli-v{{{newValue}}}/bk-{{{newValue}}}-aarch64-apple-darwin.tar.gz"\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.beankeeper",
      depNameTemplate: "Beankeeper",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Formula/rustfilt\\.rb$/"],
      matchStrings: [
        '  url "https://static\\.crates\\.io/crates/rustfilt/rustfilt-[^"]+\\.crate"\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: '  url "https://static.crates.io/crates/rustfilt/rustfilt-{{{newValue}}}.crate"\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.rustfilt",
      depNameTemplate: "Rustfilt",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Formula/pgrun\\.rb$/"],
      matchStrings: [
        '  url "https://github\\.com/pgrundev/pgrun-cli/releases/download/v[^"]+/pgrun_[^"]+_darwin_arm64\\.tar\\.gz"\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: '  url "https://github.com/pgrundev/pgrun-cli/releases/download/v{{{newValue}}}/pgrun_{{{newValue}}}_darwin_arm64.tar.gz"\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.pgrun",
      depNameTemplate: "PGRun CLI",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Formula/pplx\\.rb$/"],
      matchStrings: [
        '  url "https://github\\.com/perplexityai/perplexity-cli/releases/download/v[^"]+/pplx-aarch64-apple-darwin\\.bin"\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: '  url "https://github.com/perplexityai/perplexity-cli/releases/download/v{{{newValue}}}/pplx-aarch64-apple-darwin.bin"\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.pplx",
      depNameTemplate: "Perplexity CLI",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Casks/buskill\\.rb$/"],
      matchStrings: [
        'cask "buskill" do\n  version "(?<currentValue>[^"]+)"\n  sha256 "(?<currentDigest>[a-f0-9]{64})"',
      ],
      autoReplaceStringTemplate: 'cask "buskill" do\n  version "{{{newValue}}}"\n  sha256 "{{{newDigest}}}"',
      datasourceTemplate: "custom.buskill",
      depNameTemplate: "BusKill",
      versioningTemplate: "semver",
    },
  ],

  customDatasources: {
    "cua-driver": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/trycua/cua/releases?per_page=100",
      transformTemplates: [
        '{ "releases": $map($[$match(tag_name, /^cua-driver-rs-v[0-9]+\\.[0-9]+\\.[0-9]+$/)], function($release) { ($version := $substringAfter($release.tag_name, "cua-driver-rs-v"); { "version": $version, "releaseTimestamp": $release.published_at, "digest": $substringAfter($release.assets[name = "cua-driver-rs-" & $version & "-darwin-universal.tar.gz"].digest, "sha256:") }) }) }',
      ],
    },
    "kraken-desktop": {
      defaultRegistryUrlTemplate: "https://desktop-downloads.kraken.com/latest.json",
      transformTemplates: [
        '{ "releases": [{ "version": version & "," & revision, "digest": files.macos.sha256 }] }',
      ],
    },
    "mewt": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/trailofbits/mewt/releases?per_page=100",
      transformTemplates: [
        '{ "releases": $map($[$match(tag_name, /^v[0-9]+\\.[0-9]+\\.[0-9]+$/)], function($release) { ($version := $substringAfter($release.tag_name, "v"); { "version": $version, "releaseTimestamp": $release.published_at, "digest": $substringAfter($release.assets[name = "mewt-aarch64-apple-darwin.tar.xz"].digest, "sha256:") }) }) }',
      ],
    },
    "muton": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/trailofbits/muton/releases?per_page=100",
      transformTemplates: [
        '{ "releases": $map($[$match(tag_name, /^v[0-9]+\\.[0-9]+\\.[0-9]+$/)], function($release) { ($version := $substringAfter($release.tag_name, "v"); { "version": $version, "releaseTimestamp": $release.published_at, "digest": $substringAfter($release.assets[name = "muton-aarch64-apple-darwin.tar.xz"].digest, "sha256:") }) }) }',
      ],
    },
    "beankeeper": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/Govcraft/beankeeper/releases?per_page=100",
      transformTemplates: [
        '{ "releases": $map($[$match(tag_name, /^beankeeper-cli-v[0-9]+\\.[0-9]+\\.[0-9]+$/)], function($release) { ($version := $substringAfter($release.tag_name, "beankeeper-cli-v"); { "version": $version, "releaseTimestamp": $release.published_at, "digest": $substringAfter($release.assets[name = "bk-" & $version & "-aarch64-apple-darwin.tar.gz"].digest, "sha256:") }) }) }',
      ],
    },
    "pgrun": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/pgrundev/pgrun-cli/releases?per_page=100",
      transformTemplates: [
        '{ "releases": $map($[$match(tag_name, /^v[0-9]+\\.[0-9]+\\.[0-9]+$/)], function($release) { ($version := $substringAfter($release.tag_name, "v"); { "version": $version, "releaseTimestamp": $release.published_at, "digest": $substringAfter($release.assets[name = "pgrun_" & $version & "_darwin_arm64.tar.gz"].digest, "sha256:") }) }) }',
      ],
    },
    "pplx": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/perplexityai/perplexity-cli/releases?per_page=100",
      transformTemplates: [
        '{ "releases": $map($[$match(tag_name, /^v[0-9]+\\.[0-9]+\\.[0-9]+$/)], function($release) { ($version := $substringAfter($release.tag_name, "v"); { "version": $version, "releaseTimestamp": $release.published_at, "digest": $substringAfter($release.assets[name = "pplx-aarch64-apple-darwin.bin"].digest, "sha256:") }) }) }',
      ],
    },
    // Assets uploaded before GitHub started recording digests carry none, so a
    // release that predates that reaches the PR with an empty sha256 and fails
    // the `smoke` job rather than landing a wrong one.
    "buskill": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/BusKill/buskill-app/releases?per_page=100",
      transformTemplates: [
        '{ "releases": $map($[$match(tag_name, /^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$/)], function($release) { ($version := $substringAfter($release.tag_name, "v"); { "version": $version, "releaseTimestamp": $release.published_at, "digest": $substringAfter($release.assets[name = "buskill-mac-v" & $version & "-x86_64.dmg"].digest, "sha256:") }) }) }',
      ],
    },
    "rustfilt": {
      defaultRegistryUrlTemplate: "https://crates.io/api/v1/crates/rustfilt/versions?per_page=100",
      transformTemplates: [
        '{ "releases": $map($filter(versions, function($v) { $not($v.yanked) }), function($v) { { "version": $v.num, "releaseTimestamp": $v.updated_at, "digest": $v.checksum } }) }',
      ],
    },
  },

  timezone: "Etc/UTC",
  schedule: ["before 6am"],
  labels: ["dependencies"],
  commitMessageLowerCase: "never",

  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",

  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  automerge: false,

  // Load-bearing. The signature ruleset rejects unsigned git-CLI commits.
  // platformCommit makes GitHub sign what Renovate creates.
  platformCommit: "enabled",

  osvVulnerabilityAlerts: true,

  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    schedule: [],
    automerge: false,
    labels: ["dependencies", "security"],
  },

  packageRules: [
    {
      description: ["Kraken's feed omits release timestamps."],
      matchManagers: ["custom.regex"],
      matchPackageNames: ["Kraken Desktop"],
      minimumReleaseAge: null,
    },
    {
      description: [
        "Action digest refreshes. The tag is unchanged and only the resolved digest moves, so this re-pins the same declared release. pinact checks the result in `gate:ci`.",
      ],
      matchManagers: ["github-actions"],
      addLabels: ["security"],
    },
  ],

  // SHA256-fetched workflow tools remain manual pairs.
}
