{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // No package manifest. enabledManagers is github-actions only.
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
  ],

  enabledManagers: ["github-actions"],

  timezone: "Etc/UTC",
  schedule: ["before 6am"],
  labels: ["dependencies"],
  commitMessageLowerCase: "never",

  minimumReleaseAge: "7 days",
  internalChecksFilter: "strict",

  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  automerge: false,

  // Load-bearing. The signature ruleset rejects unsigned git-CLI commits.
  // platformCommit makes GitHub sign what Renovate creates.
  platformCommit: "enabled",

  osvVulnerabilityAlerts: true,

  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    schedule: [],
    automerge: false,
    labels: ["dependencies", "security"],
  },

  packageRules: [
    {
      description: [
        "Action digest refreshes. The tag is unchanged and only the resolved digest moves, so this re-pins the same declared release. pinact checks the result in `gate:ci`.",
      ],
      matchManagers: ["github-actions"],
      addLabels: ["security"],
    },
  ],

  // SHA256-fetched tool versions are a manual pair. Renovate cannot recompute the hash.
}
